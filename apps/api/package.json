{
  "name": "@crosmos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "bench:compare": "bun scripts/benchmark-compare.ts",
    "test": "bun test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@composio/core": "^0.16.0",
    "@crosmos/ai": "workspace:*",
    "@crosmos/db": "workspace:*",
    "@crosmos/observability": "workspace:*",
    "@crosmos/runtime": "workspace:*",
    "@crosmos/types": "workspace:*",
    "@crosmos/vector": "workspace:*",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.3",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@crosmos/test-support": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.3",
    "wrangler": "4"
  }
