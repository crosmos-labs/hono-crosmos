# Copy to .dev.vars for local dev. NEVER commit .dev.vars.

# LLM providers — at least one is required. The active one is selected by
# LLM_PROVIDER in wrangler.toml (defaults to "openrouter"). Keys for the
# inactive provider are ignored at runtime.
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENAI_API_KEY=sk-xxx

# Embeddings default to Cloudflare Workers AI (@cf/baai/bge-m3, 1024 dims) via
# the AI binding — no key needed. Set EMBEDDINGS_PROVIDER=openai (wrangler.toml)
# to use OpenAI text-embedding-3-small (1536 dims) instead, which reuses
# OPENAI_API_KEY above.

SENTRY_DSN=

# --- Fully-local benchmark path (no Cloudflare AI/Vectorize) -----------------
# Values here override wrangler.toml [vars] for `wrangler dev`. Must MATCH the
# API worker's local config so ingested document vectors and search query
# vectors share one embedding space. See docs/local-development.md. Uncomment:
#
# VECTOR_STORE=pg                       # write vectors to the local Postgres column
# EMBEDDINGS_PROVIDER=openrouter        # openai/text-embedding-3-small @ 1024-dim over HTTP
# LLM_PROVIDER=openrouter               # extraction LLM over HTTP (already the default)
# (OPENROUTER_API_KEY above is reused for both embeddings and the extraction LLM)
