{
  "name": "@crosmos/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir=dist",
    "deploy:production": "wrangler deploy --env production",
    "test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://crosmos:crosmos@localhost:5433/crosmos_test_ingestion} bun test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@crosmos/ai": "workspace:*",
    "@crosmos/db": "workspace:*",
    "@crosmos/observability": "workspace:*",
    "@crosmos/runtime": "workspace:*",
    "@crosmos/types": "workspace:*",
    "@crosmos/vector": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fuzzball": "^2.2.6",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@crosmos/test-support": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.3",
    "wrangler": "4"
  }
}
