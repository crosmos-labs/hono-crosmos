    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.3",
    "wrangler": "4"
  }
}
