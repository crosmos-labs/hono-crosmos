    {
      "id": 5,
      "type": "stat",
      "title": "Non-2xx on API paths",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=~\"$service\"} | json | event=`http.request` | path=~`/api/.+|/health` | status_code>=400 [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Errors on real endpoints only. Unfiltered, this tile is dominated by internet scanners probing /.git/config and /wp-includes paths, which all 404."
    },
