    {
      "id": 13,
      "type": "timeseries",
      "title": "p95 request duration by path (from logs)",
      "description": "duration_ms on the http.request access-log line, restricted to /api/ paths so scanner 404s do not crowd the legend.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=~\"$service\"} | json | event=`http.request` | path=~`/api/.+` | __error__=\"\" | unwrap duration_ms [$__auto]) by (path)",
          "legendFormat": "{{path}}",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Endpoints by volume",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "topk(20, sum by (method, path, status_code) (count_over_time({service_name=~\"$service\"} | json | event=`http.request` [$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Retrieval: results returned and latency",
      "description": "result_count and duration_ms from retrieval.request_completed.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "avg_over_time({service_name=~\"$service\"} | json | event=`retrieval.request_completed` | __error__=\"\" | unwrap result_count [$__auto])",
          "legendFormat": "avg results",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        },
        {
          "refId": "B",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=~\"$service\"} | json | event=`retrieval.request_completed` | __error__=\"\" | unwrap duration_ms [$__auto])",
          "legendFormat": "p95 duration",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg results"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Ingestion, from structured logs",
      "collapsed": false,
