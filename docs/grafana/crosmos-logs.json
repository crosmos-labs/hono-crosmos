    {
      "id": 17,
      "type": "timeseries",
      "title": "Memories, entities, and edges written",
      "description": "memory_count / entity_count / edge_count summed from ingestion.source_completed.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "label_replace(sum(sum_over_time({service_name=~\"$service\"} | json | event=`ingestion.source_completed` | __error__=\"\" | unwrap memory_count [$__auto])), \"kind\", \"memories\", \"\", \"\")",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        },
        {
          "refId": "B",
          "editorMode": "code",
          "queryType": "range",
          "expr": "label_replace(sum(sum_over_time({service_name=~\"$service\"} | json | event=`ingestion.source_completed` | __error__=\"\" | unwrap entity_count [$__auto])), \"kind\", \"entities\", \"\", \"\")",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        },
        {
          "refId": "C",
          "editorMode": "code",
          "queryType": "range",
          "expr": "label_replace(sum(sum_over_time({service_name=~\"$service\"} | json | event=`ingestion.source_completed` | __error__=\"\" | unwrap edge_count [$__auto])), \"kind\", \"edges\", \"\", \"\")",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
