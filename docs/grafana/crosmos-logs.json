      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=~\"$service\"} | detected_level=\"error\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
