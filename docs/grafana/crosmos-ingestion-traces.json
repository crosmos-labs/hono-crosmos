      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Entry path: RPC fast path vs queue backstop (p95)",
      "description": "Root span name on the ingestion worker: jsrpc is the direct service-binding call, queue is the durable backstop, scheduled is the redrive cron.",
