            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 job duration",
      "description": "Worst p95 of ingestion.job_total in the window. One job can cover several sources.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"ingestion.job_total\" } | quantile_over_time(duration, .95)",
