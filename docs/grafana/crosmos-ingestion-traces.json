    {
      "id": 11,
      "type": "bargauge",
      "title": "Stage p95, ranked (worst in window)",
      "description": "Every ingestion_stage.* span ranked by its worst p95 bucket. Top bar is the stage to attack.",
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 0,
        "y": 14
