{
  "uid": "crosmos-ingestion-traces",
  "title": "Crosmos ingestion traces",
  "description": "Ingestion pipeline only. Filters on ingestion.job_total / ingestion.source_total / ingestion_stage.* spans. TraceQL metric panels are limited to a 25h window by Grafana Cloud.",
  "tags": [
    "crosmos",
    "traces",
    "ingestion"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "slow_ms",
        "label": "Slow threshold (ms)",
        "type": "custom",
        "query": "1000,2000,5000,10000,20000",
        "current": {
          "text": "5000",
          "value": "5000"
        },
        "options": [
          {
            "text": "1000",
            "value": "1000",
            "selected": false
          },
          {
            "text": "2000",
            "value": "2000",
            "selected": false
          },
          {
            "text": "5000",
            "value": "5000",
            "selected": true
          },
          {
            "text": "10000",
            "value": "10000",
            "selected": false
          },
          {
            "text": "20000",
            "value": "20000",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Ingestion health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs (window)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"ingestion.job_total\" } | count_over_time()",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sources (window)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
