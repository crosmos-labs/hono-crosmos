    {
      "id": 18,
      "type": "table",
      "title": "Slow source ingestions (> $slow_ms ms)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "filters": [],
          "query": "{ name = \"ingestion.source_total\" && duration > ${slow_ms}ms }",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
