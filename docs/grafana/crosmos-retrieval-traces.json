          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Where the time goes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Stage p95, ranked (worst in window)",
      "description": "Every api_stage.* span on the retrieval path, ranked by its worst p95 bucket in the selected window. This is the per-stage latency budget view: the top bar is where retrieval time actually goes.",
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name =~ \"api_stage.(search_total|retrieval_query_embedding|signal_semantic|signal_keyword|signal_graph|signal_temporal|rerank|search_response_build|search_response_serialize|concurrency_acquire|global_ai_throttle|plan_rate_limit|auth_total|visibility_scope|space_access|entitlements|monthly_quota|memory_ann_batch)\" } | quantile_over_time(duration, .95) by (name)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "sortBy": "Value",
        "sortOrder": "desc"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*api_stage\\.([a-z_]+).*",
            "renamePattern": "$1"
          }
        },
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "max"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Max",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
