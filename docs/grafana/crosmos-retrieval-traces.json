      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" && duration > ${slow_ms}ms }",
