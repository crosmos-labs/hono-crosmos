{
  "uid": "crosmos-retrieval-traces",
  "title": "Crosmos retrieval traces",
  "description": "Search/retrieval path only. Filters on the api_stage.search_total span so normal API traffic is excluded. TraceQL metric panels are limited to a 25h window by Grafana Cloud.",
  "tags": [
    "crosmos",
    "traces",
    "retrieval"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "slow_ms",
        "label": "Slow threshold (ms)",
        "type": "custom",
        "query": "500,1000,2000,3000,5000",
        "current": {
          "text": "2000",
          "value": "2000"
        },
        "options": [
          {
            "text": "500",
            "value": "500",
            "selected": false
          },
          {
            "text": "1000",
            "value": "1000",
            "selected": false
          },
          {
            "text": "2000",
            "value": "2000",
            "selected": true
          },
          {
            "text": "3000",
            "value": "3000",
            "selected": false
          },
          {
            "text": "5000",
            "value": "5000",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Search health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Search rate (avg)",
      "description": "Spans/sec of api_stage.search_total.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | rate()",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Searches (window)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | count_over_time()",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 search stage",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage=`search_total` | __error__=\"\" | unwrap duration_ms [$__range]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Exact 95th percentile of search_total over the selected window, computed from the duration_ms field on retrieval.stage_completed log lines. Loki is used here rather than TraceQL metrics because TraceQL quantiles come from an exponential histogram and snap to powers of two (1.07s, 2.15s, 4.29s, 17.18s)."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p99 search stage",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "quantile_over_time(0.99, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage=`search_total` | __error__=\"\" | unwrap duration_ms [$__range]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2000
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Exact 99th percentile of search_total over the selected window, from Loki duration_ms."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "p95 end-to-end /api/v1/search",
      "description": "Exact p95 of the whole successful /api/v1/search request as the server measured it, from the http.request access log. This is the number a US client waits for, minus network time.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`http.request` | path=`/api/v1/search` | status_code=200 | __error__=\"\" | unwrap duration_ms [$__range]) by (path)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1500
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Failed searches",
      "description": "api_stage.search_total spans with crosmos.outcome = failed.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" && span.crosmos.outcome = \"failed\" } | count_over_time()",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Search stage latency percentiles",
      "description": "Exact percentiles of the search_total stage from Loki duration_ms.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.5, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage=`search_total` | __error__=\"\" | unwrap duration_ms [$__auto]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage=`search_total` | __error__=\"\" | unwrap duration_ms [$__auto]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.99, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage=`search_total` | __error__=\"\" | unwrap duration_ms [$__auto]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Client-visible request vs search stage (p95)",
      "description": "The gap between the two lines is auth, middleware, and admission overhead outside the search stage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`http.request` | path=`/api/v1/search` | status_code=200 | __error__=\"\" | unwrap duration_ms [$__auto]) by (path)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "legendFormat": "client-visible request p95"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage=`search_total` | __error__=\"\" | unwrap duration_ms [$__auto]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "legendFormat": "search stage p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Where the time goes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Stage p95, ranked (exact, whole window)",
      "description": "Exact p95 per stage over the selected window, from Loki duration_ms. search_total is excluded so the sub-stages are comparable. Top bar is where retrieval time actually goes.",
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage!=`search_total` | __error__=\"\" | unwrap duration_ms [$__range]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "sortBy": "Value",
        "sortOrder": "desc"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Stage p95 over time (exact)",
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 10,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`retrieval.stage_completed` | stage=~`rerank|retrieval_query_embedding|signal_graph|signal_semantic|plan_rate_limit|concurrency_acquire|global_ai_throttle|memory_ann_batch|space_access|entitlements` | __error__=\"\" | unwrap duration_ms [$__auto]) by (stage)",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "legendFormat": "{{stage}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Model provider calls inside search (p95)",
      "description": "Raw fetch spans to the embedder and reranker from the API worker.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ resource.service.name = \"crosmos-api-production\" && name = \"fetch\" && span.url.path =~ \"/v1/embeddings|/v1/models/rerank\" } | quantile_over_time(duration, .95) by (span.url.path)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Vector store calls inside search (p95)",
      "description": "Qdrant fetch spans, split by collection endpoint.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ resource.service.name = \"crosmos-api-production\" && name = \"fetch\" && span.url.path =~ \"/collections/.*\" } | quantile_over_time(duration, .95) by (span.url.path)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Pick a trace (click a trace ID to load its waterfall below)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "table",
      "title": "Slow searches (> $slow_ms ms)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" && duration > ${slow_ms}ms }",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Duration",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Load waterfall below",
                    "url": "/d/crosmos-retrieval-traces/crosmos-retrieval-traces?${__url_time_range}&var-slow_ms=${slow_ms}&var-trace_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Failed searches",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" && span.crosmos.outcome = \"failed\" }",
