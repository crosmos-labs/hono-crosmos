        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api.request_total\" && span.url.path = \"/api/v1/search\" } | quantile_over_time(duration, .95)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        },
        {
          "refId": "B",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | quantile_over_time(duration, .95)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
