{
  "uid": "crosmos-retrieval-traces",
  "title": "Crosmos retrieval traces",
  "description": "Search/retrieval path only. Filters on the api_stage.search_total span so normal API traffic is excluded. TraceQL metric panels are limited to a 25h window by Grafana Cloud.",
  "tags": [
    "crosmos",
    "traces",
    "retrieval"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "slow_ms",
        "label": "Slow threshold (ms)",
        "type": "custom",
        "query": "500,1000,2000,3000,5000",
        "current": {
          "text": "2000",
          "value": "2000"
        },
        "options": [
          {
            "text": "500",
            "value": "500",
            "selected": false
          },
          {
            "text": "1000",
            "value": "1000",
            "selected": false
          },
          {
            "text": "2000",
            "value": "2000",
            "selected": true
          },
          {
            "text": "3000",
            "value": "3000",
            "selected": false
          },
          {
            "text": "5000",
            "value": "5000",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Search health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Search rate (avg)",
      "description": "Spans/sec of api_stage.search_total.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | rate()",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Searches (window)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | count_over_time()",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 search stage",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | quantile_over_time(duration, .95)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Worst 95th percentile of the api_stage.search_total span over the selected window. Empty TraceQL buckets report 0, so these tiles reduce with max rather than last value."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p99 search stage",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | quantile_over_time(duration, .99)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Worst 99th percentile of the api_stage.search_total span over the selected window."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "p95 end-to-end /api/v1/search",
      "description": "api.request_total span filtered to the search path: everything the client waits for, including auth and middleware.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api.request_total\" && span.url.path = \"/api/v1/search\" } | quantile_over_time(duration, .95)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Failed searches",
      "description": "api_stage.search_total spans with crosmos.outcome = failed.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" && span.crosmos.outcome = \"failed\" } | count_over_time()",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Search stage latency percentiles",
      "description": "quantile_over_time on the api_stage.search_total span duration.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "filters": [],
          "query": "{ name = \"api_stage.search_total\" } | quantile_over_time(duration, .5, .95, .99)",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Client-visible request vs search stage (p95)",
      "description": "The gap between the two lines is auth, middleware, and admission overhead outside the search stage.",
