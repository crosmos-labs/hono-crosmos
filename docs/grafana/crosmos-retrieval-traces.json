        "overrides": []
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*api_stage\\.([a-z_]+).*",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Model provider calls inside search (p95)",
      "description": "Raw fetch spans to the embedder and reranker from the API worker.",
      "gridPos": {
        "h": 8,
        "w": 12,
