          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=\"crosmos-api-production\"} | json | event=`http.request` | path=`/api/v1/search` | status_code=200 | __error__=\"\" | unwrap duration_ms [$__auto]) by (faas_version)",
