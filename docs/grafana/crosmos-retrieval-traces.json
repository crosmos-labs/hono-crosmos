            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Load waterfall below",
                    "url": "/d/crosmos-retrieval-traces/crosmos-retrieval-traces?${__url_time_range}&var-slow_ms=${slow_ms}&var-trace_id=${__value.raw}",
                    "targetBlank": false
